# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicit text files
*.py text eol=lf diff=python
*.toml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.m text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.mat binary
*.pyc binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
